# =============================================================================
# WAP_INT - environment configuration
# Copy this file to `.env` and fill in the real values.
#   Windows : copy .env.example .env
#   bash    : cp .env.example .env
# NEVER commit the real .env file.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Path the webhook is mounted on. Must match the callback URL you register
# in the Meta dashboard: https://<your-tunnel>.ngrok-free.app/webhook
WEBHOOK_PATH=/webhook

# error | warn | info | debug
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# WhatsApp Cloud API credentials
# Meta dashboard -> Your App -> WhatsApp -> API Setup
# ---------------------------------------------------------------------------

# Graph API version used for every outbound call.
WHATSAPP_API_VERSION=v21.0

# "Phone number ID" of the sender (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (optional - only used for reporting/templates).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Temporary token (24h) from API Setup, or a permanent System User token.
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Webhook security
# ---------------------------------------------------------------------------

# Any random string you invent. You type the SAME value into the Meta
# dashboard when subscribing the callback URL.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# App Secret: Meta dashboard -> App Settings -> Basic -> App Secret.
# Used to validate the X-Hub-Signature-256 header on every inbound POST.
WHATSAPP_APP_SECRET=

# Set to false ONLY while debugging locally without an app secret.
VERIFY_SIGNATURE=true

# ---------------------------------------------------------------------------
# Inbound message behaviour
# ---------------------------------------------------------------------------

# Echo an automatic reply back to whoever messages you.
AUTO_REPLY=false
AUTO_REPLY_TEXT=Thanks! Your message was received by WAP_INT.

# Send a blue-tick read receipt for every inbound message.
MARK_AS_READ=false

# ---------------------------------------------------------------------------
# Outbound HTTP
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Tunnel (local development)
# ---------------------------------------------------------------------------
# ngrok | cloudflared
TUNNEL_PROVIDER=cloudflared

# Optional: reserved ngrok domain (paid plans) e.g. my-app.ngrok-free.app
NGROK_DOMAIN=

# ---------------------------------------------------------------------------
# Database - reserved for future integration (folders already scaffolded)
# ---------------------------------------------------------------------------
# DB_CLIENT=postgres
# DATABASE_URL=
